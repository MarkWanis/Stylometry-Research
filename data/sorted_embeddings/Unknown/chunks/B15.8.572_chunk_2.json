  "job_B15.8.572_20251003_114346": {
    "chunk_text": "a slede on \u00fe\u00e6t white stanas, & \u00fear on \u00fea Efter strete in \u00feat white sic, efter \u00fea sice on \u00feone whiten halh, and \u00feer on \u00feene broc, onlang broces \u00feat This beo\u00fe \u00f0a land ymere at Hiltune & at Feo\u00feerestane. Erest of Brenesfopde onlan \u00f0a strete on Lece broc, upward efter broce on \u00f0ana Stanieford, efter \u00f0are For\u00fe efter his hagan heies \u00f0at hit cume on \u00f0ane michelemor, and \u00f0onen on \u00f0a ealdan byri, & \u00f0anen on & \u00f0anen on \u00f0a hyll, & of \u00f0a hille on \u00f0a heafdan, for\u00fe efter \u00f0e heafdan on \u00f0one o\u00feerne hil, onlang hilles & of \u00f0ane stane \u00f0uers ofer \u00f0one mor in Ebroc, onlang broces in Brunesford \u00f0er hit er of eode. This beo\u00fe \u00f0a land ymere into Ogintune. Erest on \u00f0a greata alres, efter \u00f0a more on Wassawillan, of \u00f0a on \u00f0e dic, efter \u00f0are dic on \u00f0at fen, et hare Efter \u00fean heie \u00feet for\u00fe richte on blaca leige, on sa leie su\u00fe forte eft on \u00fee efter strete on \u00feane ford, efter Efter heredic \u00f0et on \u00fees ford on \u00feone broc, efter broce ongea streame \u00feat on ge stret efter strete \u00feat on This beo\u00fe \u00f0a land ymere into Weoleshale, erest on Weolesford. Of Weolesford, efter broce ongean streame \u00feat on myclan mor, & \u00f0an more \u00feat on rye halan, & of rye \u00de\u00e6t on efter dice \u00fe\u00e6t on \u00fea haran wi\u00fei, of \u00fean wi\u00fei \u00feat on heortsole, of heortsole on Hunten",
