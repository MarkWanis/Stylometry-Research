    "chunk_text": "tene. \u00d0ys sceal on mydlengtenes wucan on tywesd\u00e6g. \u00d0ys sceal on monand\u00e6g on \u00fe\u00e6re fyftan wucan innan lenctene. \u00d0ys godspel sceal on \u00feuresd\u00e6g on \u00fe\u00e6re fiftan wucan innan lenctene. \u00d0ys godspel gebyra\u00f0 anum d\u00e6ge \u00e6r mydfastene. \u00d0ys godspel sceal on \u00fe\u00e6re mydf\u00e6stenes wucan on s\u00e6ternesd\u00e6g. \u00d0ys godspel sceal on monand\u00e6g on \u00fe\u00e6re o\u00f0re lencten wucan. \u00d0ys sceal on \u00feunresd\u00e6g on \u00fe\u00e6re forman lengten wucan. \u00d0is godspel gebyra\u00f0 on sunnand\u00e6g on \u00fe\u00e6re fiftan wucan innan lenctene. \u00d0ys godspel gebyra\u00f0 on wodnesd\u00e6g on mydf\u00e6stenes wucan. \u00d0ys sceal on tywesd\u00e6g on \u00fe\u00e6re pentecostenes wucan. \u00d0ys sceal on sunnand\u00e6g feowertyne nyht uppan eastron. \u00d0ys sceal on wodnesd\u00e6g innon \u00fe\u00e6re fiftan lencten wucan & to cyrichalgungum. \u00d0ys sceal on fryged\u00e6g on mydf\u00e6stenes wucan. \u00d0ys sceal twam dagum \u00e6r palmsunnand\u00e6ge. \u00d0ys godspel sceal on monand\u00e6g innan \u00fe\u00e6re palmwucan. \u00d0ys sceal on tywesd\u00e6g on \u00fe\u00e6re palmwucan. \u00d0ys gebyra\u00f0 on \u00feunresd\u00e6g \u00e6r eastron. \u00d0ys godspel gebyra\u00f0 on fryged\u00e6g on \u00fe\u00e6re feor\u00f0an wucan ofer eastron. \u00d0ys godspel gebyra\u00f0 to \u00fe\u00e6re m\u00e6ssan phylippi & iacobi. \u00d0ys sceal on pentecostenes m\u00e6s",
