    "text": "\u00d0is syndan \u00fea land gem\u00e6ro to cliue.\n\u00c6rost of nor\u00f0 tyrl on m\u00e6r cumb.\nOf \u00feam cumbe on grena weg, of \u00feam wege on cocca byrig.\nOf \u00fe\u00e6ra burig on hengestes heafod, of \u00feam heafde on cippanham.\nOf cippenham on tocca byrig, of \u00fe\u00e6re byrce on hinde hlep.\nOf hinde hlepe on myle wylla, of \u00fe\u00e6re wyllan on scir wyllan.\nOf \u00fe\u00e6re wyllan on fearnsl\u00e6d.\nOf \u00feam sl\u00e6de on feower wegas, of \u00feam wegan on patacumb, \u00feer stonda\u00f0 apeltreo & mapeltreo tog\u00e6dere\nOf \u00feam treowan on wulfl\u00e6ge, of \u00fe\u00e6re l\u00e6ge on \u00fea aldan dic.\nOf \u00fe\u00e6re dic on walhw\u00e6g, of \u00feam wege on c\u00e6lf hyl.\nOf \u00feam hylle on fina m\u00e6de, of \u00fe\u00e6re m\u00e6de on hweolweg.\nOf \u00feam wege on sproges l\u00e6ge, of \u00fe\u00e6re l\u00e6ge on aldan dic.\nOf \u00fe\u00e6re dic on alpugan \u00feorn, of \u00feam \u00feorne on honta hlaw.\nOf \u00feam hlawe on swel hongre, of \u00feone haran stan.\nOf \u00feam stane on su\u00f0 tyrl, of su\u00f0 tyrl to \u00feam hors pole \u00e6t stoce.",
